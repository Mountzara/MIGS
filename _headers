# Cloudflare Pages applies these headers to every response.
# Documented at https://developers.cloudflare.com/pages/configuration/headers/

# Site-wide hardening
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: index, follow, noai, noimageai
  X-AI-Training: noai, noimageai
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https://*.mountzara.com https://mountzara.com data:; media-src 'self' https://*.mountzara.com https://mountzara.com blob:; connect-src 'self' https://*.mountzara.com https://mountzara.com https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Admin surface — never index, never embed, no caching
/admin/*
  X-Robots-Tag: noindex, nofollow, noai, noimageai, nosnippet, noarchive
  X-Frame-Options: DENY
  Cache-Control: no-store, max-age=0
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Patient portal — never index, never embed, no caching. Patient surface
# carries the most PHI risk; same posture as /admin.
/portal/*
  X-Robots-Tag: noindex, nofollow, noai, noimageai, nosnippet, noarchive
  X-Frame-Options: DENY
  Cache-Control: no-store, max-age=0
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# ---------------------------------------------------------------------
# DO NOT try to override Permissions-Policy or CSP for a /portal/ subpath
# in this file. It does not work, and it looks like it does.
# ---------------------------------------------------------------------
# This file APPENDS. A path-specific rule does not replace the `/*` rule
# for the same header — Pages emits BOTH lines, and the browser then
# applies its own duplicate-handling rules, which are not "most specific
# wins":
#
#   * Permissions-Policy — the FIRST occurrence of a feature wins. The
#     site-wide `camera=()` is emitted first, so a later `camera=(self)`
#     on /portal/tech-check/ is ignored entirely. It shows up in curl and
#     changes nothing.
#   * Content-Security-Policy — every policy is enforced, so the effect is
#     their INTERSECTION. A second, more permissive CSP naming
#     js.stripe.com cannot unblock anything.
#
# Both were attempted here on 2026-08-13 and were inert. Only `!` (unset)
# genuinely removes an inherited header.
#
# Separately, this file is applied by the static-asset layer only: any
# response a Pages Function CONSTRUCTS — the pre-launch Coming Soon page,
# /portal/visit/<id>/launch, /portal/nps/<token> — never sees it.
#
# Portal headers are therefore set in code, in functions/portal/
# _middleware.js via functions/_lib/portal_headers.js, which sits in front
# of every /portal/* response and uses Headers.set() so exactly one policy
# per header reaches the browser. Change them there.

# All API endpoints — JSON, never cached, never embedded.
/api/*
  X-Robots-Tag: noindex, nofollow, noai, noimageai, nosnippet, noarchive
  Cache-Control: no-store, max-age=0
  Cross-Origin-Resource-Policy: same-origin

# Admin API endpoints — explicit no-archive on top of /api/* (older path).
/api/posts/_admin*
  X-Robots-Tag: noindex, nofollow, noai, noimageai, nosnippet, noarchive
  Cache-Control: no-store, max-age=0

# Drafts directory (whether or not it ends up populated)
/drafts/*
  X-Robots-Tag: noindex, nofollow, noai, noimageai
  Cache-Control: no-store, max-age=0

# Homepage HTML — never served from a stale browser cache.
# 2026-08-10: the opening choreography lives INLINE in index.html (the
# bootstrap owns it), so a browser holding an old copy of this document
# runs old choreography no matter how many times the site is deployed —
# indistinguishable, from the viewer's side, from "the fix did nothing".
# The heavy assets stay immutably cached; only this 170KB document
# revalidates every time.
/
  Cache-Control: no-store, max-age=0
/index.html
  Cache-Control: no-store, max-age=0

# Static assets — hash-versioned (?v=) or stable filenames, so they can be
# cached hard. Added 2026-08-11: they were on a 4-hour cache, so every repeat
# visit re-validated ~530KB of CSS+JS for nothing.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/images/*
  Cache-Control: public, max-age=604800
