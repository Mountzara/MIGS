{
  "slug": "csi",
  "title": "Central-sensitization check-in (CSI Part A)",
  "short_name": "CSI",
  "tier": 2,
  "domain": "pain_central_sensitization",
  "description": "Part A of the Central Sensitization Inventory — a validated 25-item self-report that captures clinical symptoms associated with central sensitization (chronic pelvic pain, fibromyalgia, irritable bowel, chronic headache, sleep dysfunction, mood overlap). Used at baseline for any patient with chronic pelvic pain ≥6 months or pain that has not responded as expected to peripheral therapies, and at 3-month follow-up after multimodal pain management.",
  "estimated_minutes": 5,
  "items": [
    { "id": "csi_01", "text": "I feel tired and unrefreshed when I wake up from sleep.",                                        "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_02", "text": "My muscles feel stiff and achy.",                                                                  "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_03", "text": "I have anxiety attacks.",                                                                          "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_04", "text": "I grind or clench my teeth.",                                                                      "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_05", "text": "I have diarrhea and/or constipation problems.",                                                    "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_06", "text": "I need help in performing my daily activities.",                                                   "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_07", "text": "I am sensitive to bright lights.",                                                                 "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_08", "text": "I get tired very easily when I am physically active.",                                              "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_09", "text": "I feel pain all over my body.",                                                                    "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_10", "text": "I have headaches.",                                                                                "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_11", "text": "I feel discomfort in my bladder and/or burning when I urinate.",                                   "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_12", "text": "I do not sleep well.",                                                                              "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_13", "text": "I have difficulty concentrating.",                                                                  "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_14", "text": "I have skin problems such as dryness, itchiness, or rashes.",                                      "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_15", "text": "Stress makes my physical symptoms get worse.",                                                     "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_16", "text": "I feel sad or depressed.",                                                                          "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_17", "text": "I have low energy.",                                                                                "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_18", "text": "I have muscle tension in my neck and shoulders.",                                                   "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_19", "text": "I have pain in my jaw.",                                                                            "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_20", "text": "Certain smells, such as perfumes, make me feel dizzy or nauseous.",                                 "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_21", "text": "I have to urinate frequently.",                                                                     "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_22", "text": "My legs feel uncomfortable and restless when I am trying to go to sleep at night.",                  "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_23", "text": "I have difficulty remembering things.",                                                              "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_24", "text": "I suffered trauma as a child.",                                                                     "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] },
    { "id": "csi_25", "text": "I have pelvic pain.",                                                                               "type": "choice", "required": true, "options": [{ "value": 0, "label": "Never" },{ "value": 1, "label": "Rarely" },{ "value": 2, "label": "Sometimes" },{ "value": 3, "label": "Often" },{ "value": 4, "label": "Always" }] }
  ],
  "scoring": {
    "method": "sum",
    "note": "Sum all 25 item values (each 0–4). Range 0–100. The published cutoff of 40 distinguishes patients with central sensitization syndromes from controls. Severity bands per Neblett 2013.",
    "items": ["csi_01","csi_02","csi_03","csi_04","csi_05","csi_06","csi_07","csi_08","csi_09","csi_10","csi_11","csi_12","csi_13","csi_14","csi_15","csi_16","csi_17","csi_18","csi_19","csi_20","csi_21","csi_22","csi_23","csi_24","csi_25"],
    "range": [0, 100],
    "lower_is_better": true,
    "interpretation_bands": [
      { "min": 0,  "max": 29, "label": "subclinical",  "patient_label": "Central-sensitization symptoms are below the typical clinical threshold." },
      { "min": 30, "max": 39, "label": "mild",         "patient_label": "Mild central-sensitization symptoms." },
      { "min": 40, "max": 49, "label": "moderate",     "patient_label": "Moderate central-sensitization symptoms — multimodal pain care recommended." },
      { "min": 50, "max": 59, "label": "severe",       "patient_label": "Severe central-sensitization symptoms — multidisciplinary management warranted." },
      { "min": 60, "max": 100,"label": "extreme",      "patient_label": "Extreme central-sensitization symptom burden — coordinated multidisciplinary management strongly recommended." }
    ]
  },
  "thresholds": [
    { "rule": "total >= 40",            "flag_type": "csi_above_clinical_cutoff", "severity": "warning", "message": "CSI ≥40 — above the published clinical cutoff for central sensitization. Consider pelvic-floor PT, mind-body therapies, OMT, and central pain management alongside any peripheral treatment.", "follow_up_action": "clinician_alert" },
    { "rule": "total >= 60",            "flag_type": "csi_extreme",               "severity": "urgent",  "message": "CSI ≥60 — extreme burden. Multidisciplinary coordinated pain management is recommended; sole peripheral surgery is unlikely to fully resolve symptoms.",                                "follow_up_action": "clinician_alert" },
    { "rule": "delta_vs_baseline >= 15","flag_type": "csi_worsening",             "severity": "warning", "message": "CSI has worsened by ≥15 points compared to baseline. Recommend earlier follow-up.",                                                                                                       "follow_up_action": "clinician_alert" }
  ],
  "citation": "Mayer TG, Neblett R, Cohen H, Howard KJ, Choi YH, Williams MJ, Perez Y, Gatchel RJ. The development and psychometric validation of the central sensitization inventory. Pain Pract 2012;12(4):276-85. PMID: 21951710; Neblett R, et al. The Central Sensitization Inventory: establishing clinically significant values. J Pain 2013;14(5):438-45. PMID: 23490634",
