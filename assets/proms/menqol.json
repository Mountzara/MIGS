{
  "slug": "menqol",
  "title": "Menopause quality-of-life check-in (MENQOL)",
  "short_name": "MENQOL",
  "tier": 2,
  "domain": "menopause",
  "description": "The 29-item Menopause-Specific Quality of Life questionnaire. Four domains: vasomotor (3 items), psychosocial (7 items), physical (16 items), and sexual (3 items). Each item is asked as 'have you experienced this in the past month?' (yes/no); if yes, the patient rates how bothered (0–6). Used at baseline and at 3-month follow-up for any patient in the menopausal transition, established menopause, or with vasomotor / urogenital syndrome of menopause (GSM) symptoms.",
  "estimated_minutes": 6,
  "items": [
    { "id": "menqol_01", "text": "How bothered have you been by hot flushes / flashes in the past month?",                                                "type": "scale_0_6_with_none", "required": true, "subscale": "vasomotor",     "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_02", "text": "How bothered have you been by night sweats in the past month?",                                                          "type": "scale_0_6_with_none", "required": true, "subscale": "vasomotor",     "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_03", "text": "How bothered have you been by sweating in the past month?",                                                              "type": "scale_0_6_with_none", "required": true, "subscale": "vasomotor",     "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },

    { "id": "menqol_04", "text": "Being dissatisfied with my personal life",                                                                                "type": "scale_0_6_with_none", "required": true, "subscale": "psychosocial",  "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_05", "text": "Feeling anxious or nervous",                                                                                              "type": "scale_0_6_with_none", "required": true, "subscale": "psychosocial",  "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_06", "text": "Experiencing poor memory",                                                                                                "type": "scale_0_6_with_none", "required": true, "subscale": "psychosocial",  "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_07", "text": "Accomplishing less than I used to",                                                                                       "type": "scale_0_6_with_none", "required": true, "subscale": "psychosocial",  "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_08", "text": "Feeling depressed, down, or blue",                                                                                        "type": "scale_0_6_with_none", "required": true, "subscale": "psychosocial",  "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_09", "text": "Being impatient with other people",                                                                                       "type": "scale_0_6_with_none", "required": true, "subscale": "psychosocial",  "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_10", "text": "Feelings of wanting to be alone",                                                                                         "type": "scale_0_6_with_none", "required": true, "subscale": "psychosocial",  "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },

    { "id": "menqol_11", "text": "Flatulence (wind, gas) or gas pains",                                                                                     "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_12", "text": "Aching in muscles and joints",                                                                                            "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_13", "text": "Feeling tired or worn out",                                                                                               "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_14", "text": "Difficulty sleeping",                                                                                                     "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_15", "text": "Aches in the back of my neck or head",                                                                                    "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_16", "text": "Decrease in physical strength",                                                                                            "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_17", "text": "Decrease in stamina",                                                                                                     "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_18", "text": "Feeling a lack of energy",                                                                                                "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_19", "text": "Drying skin",                                                                                                             "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_20", "text": "Weight gain",                                                                                                              "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_21", "text": "Increased facial hair",                                                                                                    "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_22", "text": "Changes in appearance, texture, or tone of skin",                                                                          "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_23", "text": "Feeling bloated",                                                                                                          "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_24", "text": "Low backache",                                                                                                            "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_25", "text": "Frequent urination",                                                                                                       "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_26", "text": "Involuntary urination when laughing or coughing",                                                                          "type": "scale_0_6_with_none", "required": true, "subscale": "physical",      "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },

    { "id": "menqol_27", "text": "Change in your sexual desire",                                                                                              "type": "scale_0_6_with_none", "required": true, "subscale": "sexual",        "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_28", "text": "Vaginal dryness during intercourse",                                                                                       "type": "scale_0_6_with_none", "required": true, "subscale": "sexual",        "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } },
    { "id": "menqol_29", "text": "Avoiding intimacy",                                                                                                        "type": "scale_0_6_with_none", "required": true, "subscale": "sexual",        "scale": { "min": 0, "max": 6, "none_label": "Did not experience this", "min_label": "Not at all bothered", "max_label": "Extremely bothered" } }
  ],
  "scoring": {
    "method": "subscale_mean",
    "note": "Each item is 'experienced (1–7) vs. not (0)'. Standard MENQOL convention: if not experienced, item scored 1; if experienced, scored from 2 (not at all bothered) to 8 (extremely bothered). For this digital implementation we store the patient's bother-rating directly (0–6 when experienced, missing/none when not), then transform to the conventional 1–8 scale at scoring time: experienced + bother=0 → 2; bother=6 → 8; not experienced → 1. Each subscale total is the mean of its items (range 1–8). Lower = better quality of life.",
    "subscales": {
      "vasomotor":    { "items": ["menqol_01","menqol_02","menqol_03"] },
      "psychosocial": { "items": ["menqol_04","menqol_05","menqol_06","menqol_07","menqol_08","menqol_09","menqol_10"] },
      "physical":     { "items": ["menqol_11","menqol_12","menqol_13","menqol_14","menqol_15","menqol_16","menqol_17","menqol_18","menqol_19","menqol_20","menqol_21","menqol_22","menqol_23","menqol_24","menqol_25","menqol_26"] },
      "sexual":       { "items": ["menqol_27","menqol_28","menqol_29"] }
    },
    "transform": "experienced ? (bother + 2) : 1",
    "aggregate": "mean_of_subscale_items_separately",
    "range": [1, 8],
    "lower_is_better": true,
    "interpretation_bands": [
      { "min": 1.0, "max": 2.5, "label": "minimal_burden",     "patient_label": "Menopausal symptoms are having minimal impact on your quality of life." },
      { "min": 2.6, "max": 4.5, "label": "moderate_burden",    "patient_label": "Menopausal symptoms are having a moderate impact." },
      { "min": 4.6, "max": 6.0, "label": "substantial_burden", "patient_label": "Menopausal symptoms are substantially affecting your daily life." },
      { "min": 6.1, "max": 8.0, "label": "severe_burden",      "patient_label": "Menopausal symptoms are severely affecting your quality of life." }
    ]
  },
  "thresholds": [
    { "rule": "subscale.vasomotor >= 4.5",       "flag_type": "menqol_vasomotor_substantial",  "severity": "warning", "message": "MENQOL vasomotor subscale ≥4.5 — VMS substantially affecting QoL. Consider escalation of MHT or non-hormonal therapy discussion.",       "follow_up_action": "clinician_alert" },
    { "rule": "subscale.psychosocial >= 4.5",    "flag_type": "menqol_psychosocial_substantial","severity": "warning", "message": "MENQOL psychosocial subscale ≥4.5 — consider PHQ-9 / GAD-7 follow-up plus targeted support.",                                       "follow_up_action": "clinician_alert" },
    { "rule": "subscale.sexual >= 4.5",          "flag_type": "menqol_sexual_substantial",     "severity": "warning", "message": "MENQOL sexual subscale ≥4.5 — GSM symptoms warrant focused evaluation (vaginal estrogen, DHEA, ospemifene, lubrication, sex therapy referral).", "follow_up_action": "clinician_alert" },
    { "rule": "subscale.physical >= 4.5",        "flag_type": "menqol_physical_substantial",   "severity": "warning", "message": "MENQOL physical subscale ≥4.5 — broad somatic burden warranting integrated management plan.",                                          "follow_up_action": "clinician_alert" },
    { "rule": "delta_vs_baseline >= 1.0",        "flag_type": "menqol_worsening",              "severity": "warning", "message": "MENQOL subscale mean has worsened by ≥1.0 compared to baseline. Recommend earlier follow-up.",                                       "follow_up_action": "clinician_alert" }
  ],
  "citation": "Hilditch JR, Lewis J, Peter A, van Maris B, Ross A, Franssen E, Guyatt GH, Norton PG, Dunn E. A menopause-specific quality of life questionnaire: development and psychometric properties. Maturitas 1996;24(3):161-75. PMID: 8844630",
