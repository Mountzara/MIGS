# Cloudflare Pages redirect rules
/about /about/index.html 200

# 2026-05-16 URL rename — the /blog/ directory was renamed to /trending/ so
# the URL label matches the actual content (kind=blog → Trend Briefs from
# Dr. Mabini's social-media response work). Any external bookmark or post
# embed that pointed at /blog/... is 301 redirected to /trending/...
/blog/ /trending/ 301
/blog/* /trending/:splat 301

# Phase 5 clinician workspace — /admin/cases/<patient_id>/ is a single
# static SPA at /admin/cases/[id]/index.html. Cloudflare Pages serves
# the literal [id] folder only when the URL also has [id] in it, so we
# rewrite any patient_id path to that one file. The SPA reads the
# patient_id from window.location.pathname itself.
/admin/cases/* /admin/cases/[id]/index.html 200
