# Cloudflare Pages redirect rules
/about /about/index.html 200

# 2026-05-16 URL rename — the /blog/ directory was renamed to /trending/ so
# the URL label matches the actual content (kind=blog → Trend Briefs from
# Dr. Mabini's social-media response work). Any external bookmark or post
# embed that pointed at /blog/... is 301 redirected to /trending/...
/blog/ /trending/ 301
/blog/* /trending/:splat 301

# Phase 5 clinician workspace — /admin/cases/<patient_id>/ routes through
# Pages Functions at functions/admin/cases/[patient_id]/index.js (and the
# snapshot subroute). The Functions serve the static SPA HTML so trailing-
# slash directory navigation in the browser works without falling back to
# the marketing homepage. _redirects rewrites were unreliable for this
# pattern — see incident note in CLAUDE.md.

# Phase 17 Sprint 1 R4 — Privacy attestation interstitial. The page is
# static (portal/visit/launch/index.html); the appointment id is read
# from the URL path client-side. Pages serves the SPA for any
# /portal/visit/<id>/launch URL.
/portal/visit/*/launch /portal/visit/launch/index.html 200
/portal/visit/*/launch/ /portal/visit/launch/index.html 200

# Phase 18 Sprint 2 R9 — NPS survey page. Static (portal/nps/index.html);
# the one-time token is read from the URL path client-side. The bare
# /portal/nps/ directory already resolves to the same file.
/portal/nps/* /portal/nps/index.html 200
